# Volcengine Ark (Seedance 2.5 Flash + Seedream 5.5)
ARK_API_KEY=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# Model safety guardrails (comma-separated allowlist; defaults to Flash only)
VIDREP_VIDEO_MODEL="doubao-seedance-2-5-flash-261115"
VIDREP_ALLOWED_VIDEO_MODELS="doubao-seedance-2-5-flash-261115"
VIDREP_IMAGE_MODEL="doubao-seedream-5-5-261028"
VIDREP_IMAGE_FALLBACK_MODEL="doubao-seedream-5-0-260128"

# Volcengine TOS object storage (for public reference media URLs)
TOS_ACCESS_KEY_ID=""
TOS_ACCESS_KEY_SECRET=""
TOS_REGION="cn-shanghai"
TOS_ENDPOINT="https://tos-cn-shanghai.volces.com"
TOS_BUCKET=""
TOS_PATH_PREFIX="reference-videos/"

# Optional alternative image providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional explicit binaries
VIDREP_FFMPEG_BIN=""
VIDREP_FFPROBE_BIN=""
